# Copy to .env.local and replace placeholders with local values.
# No database or authentication service is provisioned by this project.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-local-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
