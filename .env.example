# Copy this file to .env.local (development) or .env.production (production).
# Replace placeholder values before running the app.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_long_random_secret

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportevent_dev
POSTGRES_DB=sportevent_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: provider settings added later when authentication is implemented
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# App settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
