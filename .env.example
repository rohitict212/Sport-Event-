# Copy to .env.local and replace placeholders with local values.
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/sportevent?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Twilio Verify credentials. Keep these values private and configure them in
# the hosting provider's environment settings for production.
TWILIO_ACCOUNT_SID="replace-with-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="replace-with-twilio-verify-service-sid"
