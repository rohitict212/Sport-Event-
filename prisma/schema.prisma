generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  email         String               @unique
  mobileNumber  String?              @unique @map("mobile_number")
  name          String?
  passwordHash  String               @map("password_hash")
  otpCode       String?              @map("otp_code")
  otpExpiresAt  DateTime?            @map("otp_expires_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]
  memberships   OrganizationMember[]
  organizations Organization[]       @relation("OrgOwner")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  ownerUserId String   @map("owner_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User                 @relation("OrgOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     OrganizationMember[]
  tournaments Tournament[]
  teams       Team[]
  players     Player[]
  matches     Match[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Tournament {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]
  matches      Match[]

  // Supports a composite foreign key that prevents teams crossing organizations.
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@map("tournaments")
}

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tournamentId   String   @map("tournament_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament         Tournament   @relation(fields: [tournamentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  players            Player[]
  matchesAsTeamA     Match[]      @relation("TeamA")
  matchesAsTeamB     Match[]      @relation("TeamB")
  wonMatches         Match[]      @relation("MatchWinner")
  inningsAsBatting   Innings[]    @relation("BattingTeam")
  inningsAsBowling   Innings[]    @relation("BowlingTeam")

  @@unique([tournamentId, name])
  @@index([organizationId, createdAt])
  @@map("teams")
}

model Player {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  name           String
  role           String?
  jerseyNumber   String?  @map("jersey_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, name])
  @@index([organizationId, createdAt])
  @@map("players")
}

model Innings {
  id             String   @id @default(uuid()) @db.Uuid
  matchId        String   @map("match_id") @db.Uuid
  battingTeamId  String   @map("batting_team_id") @db.Uuid
  bowlingTeamId  String   @map("bowling_team_id") @db.Uuid
  inningsNumber  Int      @map("inning_number")
  runs           Int      @default(0)
  wickets        Int      @default(0)
  overs          Float?   @default(0)
  targetRuns     Int?     @map("target_runs")
  isComplete     Boolean  @default(false) @map("is_complete")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  battingTeam  Team         @relation("BattingTeam", fields: [battingTeamId], references: [id], onDelete: Cascade)
  bowlingTeam Team         @relation("BowlingTeam", fields: [bowlingTeamId], references: [id], onDelete: Cascade)
  scoreEvents ScoreEvent[]

  @@unique([matchId, inningsNumber])
  @@index([matchId, inningsNumber])
  @@map("innings")
}

model ScoreEvent {
  id            String   @id @default(uuid()) @db.Uuid
  inningsId     String   @map("innings_id") @db.Uuid
  overNumber    Int      @map("over_number")
  ballNumber    Int      @map("ball_number")
  runs          Int      @default(0)
  extras        Int      @default(0)
  wicketType    String?  @map("wicket_type")
  isNoBall      Boolean  @default(false) @map("is_no_ball")
  isWide        Boolean  @default(false) @map("is_wide")
  isLegBye      Boolean  @default(false) @map("is_leg_bye")
  isBye         Boolean  @default(false) @map("is_bye")
  createdAt     DateTime @default(now()) @map("created_at")

  innings Innings @relation(fields: [inningsId], references: [id], onDelete: Cascade)

  @@index([inningsId, overNumber, ballNumber])
  @@map("score_events")
}

model Match {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tournamentId   String    @map("tournament_id") @db.Uuid
  teamAId        String    @map("team_a_id") @db.Uuid
  teamBId        String    @map("team_b_id") @db.Uuid
  venueName      String?   @map("venue_name")
  scheduledAt    DateTime  @map("scheduled_at")
  status         String    @default("scheduled")
  winnerTeamId   String?   @map("winner_team_id") @db.Uuid
  resultText     String?   @map("result_text")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament   Tournament   @relation(fields: [tournamentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamA        Team         @relation("TeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB        Team         @relation("TeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  winner       Team?        @relation("MatchWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  innings      Innings[]

  @@unique([tournamentId, teamAId, teamBId, scheduledAt])
  @@index([organizationId, scheduledAt])
  @@map("matches")
}
